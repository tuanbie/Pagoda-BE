{
  "name": "pagoda-be",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/main.js --external:fastify --external:@fastify/static --external:ws --external:ioredis --external:bufferutil --external:utf-8-validate",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "load": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@sontu/shared": "file:./shared",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "description": "Tịnh Tâm Tự — realtime backend (Fastify + ws + Redis room directory)"
}
